+        val newSurfaceView = when (viewType) {
+            ViewType.VIEW_TYPE_SURFACE, ViewType.VIEW_TYPE_SURFACE_SECURE -> {
+                if (currentSurfaceView is SurfaceView) {
+                    currentSurfaceView.setSecure(viewType == ViewType.VIEW_TYPE_SURFACE_SECURE)
+                    return
+                }
+
+                SurfaceView(context).apply {
+                    setSecure(viewType == ViewType.VIEW_TYPE_SURFACE_SECURE)
+                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+                        setSurfaceLifecycle(SurfaceView.SURFACE_LIFECYCLE_FOLLOWS_ATTACHMENT)
+                    }
+                }
+            }
+
+            ViewType.VIEW_TYPE_TEXTURE -> {
+                if (currentSurfaceView is TextureView) {
+                    currentSurfaceView.isOpaque = false
+                    return
+                }
+
+                TextureView(context).apply {
+                    // TextureView is used when the video needs to participate in normal
+                    // Android view compositing (for example overflow clipping/animations).
+                    isOpaque = false
+                }
+            }
+
+            else -> {
+                DebugLog.wtf(TAG, "Unexpected view type: $viewType")
+                return
+            }
+        }
+
+        replaceSurfaceView(currentSurfaceView, newSurfaceView)
+    }
+
+    private fun replaceSurfaceView(currentSurfaceView: View, newSurfaceView: View) {
+        val contentFrame = playerView.findViewById<ViewGroup>(androidx.media3.ui.R.id.exo_content_frame)
+            ?: return
+        val surfaceIndex = contentFrame.indexOfChild(currentSurfaceView)
+        if (surfaceIndex == -1) return
+
+        val surfaceLayoutParams = currentSurfaceView.layoutParams
+        val player = playerView.player
+
+        // PlayerView clears the old video output when its player is detached. Its surfaceView
+        // field is private and final, so keep it in sync with the child we install before the
+        // player is reattached and chooses its new TextureView/SurfaceView output.
+        playerView.player = null
+        contentFrame.removeViewAt(surfaceIndex)
+        contentFrame.addView(newSurfaceView, surfaceIndex, surfaceLayoutParams)
+
+        try {
+            playerSurfaceViewField.set(playerView, newSurfaceView)
+        } catch (error: ReflectiveOperationException) {
+            // Keep PlayerView usable if a future Media3 version changes its internals.
+            contentFrame.removeView(newSurfaceView)
+            contentFrame.addView(currentSurfaceView, surfaceIndex, surfaceLayoutParams)
